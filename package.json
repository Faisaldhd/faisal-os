{
  "name": "faisal-os",
  "version": "1.0.2",
  "description": "Fai$al OS — a browser-based personal desktop OS, also packaged as a desktop app with Electron.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "Faisal Saeed Al Shahrani",
  "license": "ISC",
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "html-to-image": "^1.11.13",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "v86": "^0.5.462",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "private": true,
  "build": {
    "appId": "org.faisal.os",
    "productName": "Faisal OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Faisaldhd",
        "repo": "faisal-os",
        "releaseType": "release"
      }
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "icon": "public/icons/icon-512.png"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron-updater": "^6.8.9",
    "libheif-js": "1.19.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  }
}
