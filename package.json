{
  "name": "faisal-os",
  "version": "1.0.0",
  "description": "Fai$al OS — a browser-based personal desktop OS, also packaged as a desktop app with Electron.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "desktop": "vite build && electron .",
    "desktop:build": "vite build && electron-builder"
  },
  "keywords": [],
  "author": "Faisal Saeed Al Shahrani",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "html-to-image": "^1.11.13",
    "v86": "^0.5.462"
  },
  "type": "module",
  "private": true,
  "build": {
    "appId": "org.faisal.os",
    "productName": "Faisal OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
